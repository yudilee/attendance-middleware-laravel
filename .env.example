# ═══════════════════════════════════════════════════════════════════════
# Attendance HRM (Laravel Backend) — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# For Portainer deployment: set these environment variables in the
# container's environment settings. The application will use them
# automatically.
# ═══════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────
APP_NAME="Attendance HRM"
APP_ENV=production
APP_KEY=                          # REQUIRED. Generate with: php artisan key:generate
APP_DEBUG=false
APP_URL=https://attendance.hartonomotor-group.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (PostgreSQL) ─────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=attendance_db
DB_PORT=5432
DB_DATABASE=attendance_db
DB_USERNAME=attendance
DB_PASSWORD=                  # REQUIRED. Set this in Portainer!

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ───────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS ────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Vite ───────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
